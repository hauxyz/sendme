# ---------------------------------------------------------------------------
# SendMe configuration
#
# Copy this file to .env and generate the three secrets:
#   make init
#
# The values below are defaults for local development. For a public
# deployment, set APP_URL, API_PUBLIC_URL and TRUSTED_ORIGINS to your real
# HTTPS origins and keep COOKIE_SECURE=true.
# ---------------------------------------------------------------------------

APP_ENV=development
PORT=8080
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Required in production. Generate each value with openssl.
#   JWT_SECRET:      openssl rand -base64 48
#   ENCRYPTION_KEY:  openssl rand -base64 32   (must decode to exactly 32 bytes)
#   SIGNING_SECRET:  openssl rand -base64 32
JWT_SECRET=
ENCRYPTION_KEY=
SIGNING_SECRET=

# Sessions. COOKIE_SECURE is detected from API_PUBLIC_URL when left empty.
SESSION_TTL=168h
COOKIE_SECURE=
COOKIE_DOMAIN=
TRUSTED_ORIGINS=

# Background worker (campaigns, emails, webhooks)
WORKER_ENABLED=true
WORKER_CONCURRENCY=10

# Direct-to-MX delivery (no external SMTP server).
# MAIL_HELO_HOST should be a hostname with a PTR record pointing at this
# server's public IP. If empty, the sender domain is used for EHLO.
MAIL_HELO_HOST=
# Optional public IPv4/IPv6 address of this server. When set, the DNS panel
# shows the exact SPF record to publish.
MAIL_PUBLIC_IP=

# Local development database and Redis. Docker Compose overrides the hostnames.
DATABASE_URL=postgres://sendme:sendme@localhost:5432/sendme?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Docker Compose infrastructure
POSTGRES_USER=sendme
POSTGRES_PASSWORD=sendme
POSTGRES_DB=sendme
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=3000
